# Chuẩn hóa line endings cho repo chạy chủ yếu trên Windows
# (tránh diff ảo chỉ do CRLF/LF).
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.geojson text eol=lf

# Binary — không được chuẩn hóa/line-ending
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.pkl binary
*.joblib binary
*.rar binary
*.zip binary

# Dữ liệu raw tải từ web: giữ nguyên byte (không chuẩn hóa line-ending) để
# SHA-256 ghi trong PROVENANCE.md của từng nguồn khớp với bản trên git.
data/raw/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Bản giải nén phải khớp từng byte với ZIP/MANIFEST, kể cả nguồn raw dùng CRLF.
submissions/Nhom15_STING_PAPI/** -text
submissions/Nhom15_STING_PAPI/data/raw/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
